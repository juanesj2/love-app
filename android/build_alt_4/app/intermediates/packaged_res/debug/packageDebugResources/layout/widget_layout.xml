<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2A2A3E">

    <!-- Map background image (will contain composited avatars and lines) -->
    <ImageView
        android:id="@+id/widget_map_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.85" />

    <!-- Overlay content for simple texts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Love Widget"
            android:textColor="#FF4D6D"
            android:textSize="10sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizando..."
            android:textColor="#DDDDDD"
            android:textSize="9sp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

    </LinearLayout>

    <!-- Ghost Mode Overlay -->
    <LinearLayout
        android:id="@+id/widget_ghost_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF5F7"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <!-- A simple text icon or use a drawable -->
        <TextView
            android:id="@+id/widget_ghost_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🙈"
            android:textSize="32sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/widget_ghost_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo Fantasma Activo"
            android:textColor="#590D22"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/widget_ghost_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="La notificación y tu ubicación están ocultas."
            android:textColor="#666666"
            android:textSize="10sp"
            android:gravity="center" />
            
    </LinearLayout>

</FrameLayout>
